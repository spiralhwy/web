---
permalink: /cinema/
---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {%- set theaters = movies | uniqueTheaters %}
        {%- set theaterNames = "" %}
        {%- for t in theaters %}{% set theaterNames = theaterNames ~ (", " if not loop.first else "") ~ (t.theater | displayName) %}{% endfor %}
        {%- set description = "Daily movie showtimes for San Francisco's independent and repertory cinemas" ~ ((", including " ~ theaterNames) if theaterNames else "") ~ ". Find what's playing tonight, all in one place." %}
        <meta name="description" content="{{ description }}">
        <meta name="keywords" content="Spiral HWY, San Francisco cinema, San Francisco movie showtimes, SF movie theaters, indie films, independent theater, repertory cinema, movie showings, San Francisco events">
        <title>Spiral HWY | San Francisco Cinema</title>
        <link rel="canonical" href="{{ site.url }}/cinema/">
        <meta name="robots" content="index, follow">
        <meta name="theme-color" content="#1f1f1f">

        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Spiral HWY">
        <meta property="og:title" content="Spiral HWY | San Francisco Cinema">
        <meta property="og:description" content="{{ description }}">
        <meta property="og:url" content="{{ site.url }}/cinema/">
        <meta property="og:locale" content="en_US">
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content="Spiral HWY | San Francisco Cinema">
        <meta name="twitter:description" content="{{ description }}">

        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "Spiral HWY",
            "alternateName": "Spiral Highway",
            "url": "{{ site.url }}/",
            "description": {{ description | dump | safe }},
            "inLanguage": "en-US",
            "about": [
                {%- for t in theaters %}
                {
                    "@type": "MovieTheater",
                    "name": {{ t.theater | displayName | dump | safe }},
                    "url": {{ t.theater_link | dump | safe }},
                    "hasMap": {{ t.map | dump | safe }},
                    "address": {
                        "@type": "PostalAddress",
                        "addressLocality": "San Francisco",
                        "addressRegion": "CA",
                        "addressCountry": "US"
                    }
                }{% if not loop.last %},{% endif %}
                {%- endfor %}
            ]
        }
        </script>
        <link rel="stylesheet" href="../styles.css">
        <script data-goatcounter="https://spiralhwy.goatcounter.com/count"
                async src="//gc.zgo.at/count.js"></script>
    </head>
    <body>
        <header id="top">
            <h1 class="site-title">Spiral HWY</h1>
            <nav class="site-nav">
                <a href="./" class="nav-cinema" aria-current="page">Cinema</a>
                <span class="nav-sep">|</span>
                <a href="../music/" class="nav-music">Music</a>
            </nav>
        </header>

        {% include "calendar.njk" %}

        <div id="filter-controls">
            <button type="button" id="indie-mode-btn" class="filter-btn">Indie Mode</button>
            <div id="theater-filter-wrapper">
                <button type="button" id="theater-filter-btn" class="filter-btn">Theater Filter</button>
                <div id="theater-filter-panel">
                    <a href="#" id="theater-filter-reset">Reset</a>
                    <div id="theater-filter-list"></div>
                </div>
            </div>
        </div>

        <br>
        <main>
        {% if movies %}
            {% for m in movies %}
                <div class="sticky-wrapper" id="date-{{ m.date }}">
                    <div class="date">{{ m.date | formatDate }}</div>
                    <a href="#" class="top-btn" aria-label="Back to top">↑</a>
                </div>
                {% for movie_data in m.movies %}
                    <div class="movie-block">
                        <h2 class="movie-title">{{ movie_data.title }}</h2>
                        <div class="poster-container">
                            <img 
                                src="../posters/{{ movie_data.poster }}.png" 
                                alt="Poster for {{ movie_data.title }}"
                                width="120"
                                height="180"
                                loading="lazy"
                                decoding="async"
                            >
                        </div>
                        <div class="movie-info">
                            {% for listing in movie_data.listings %}
                                <div class="theater-info" data-theater="{{ listing.theater }}">
                                    <a href="{{ listing.theater_link }}" target="_blank" class="theater-name">
                                        {{ listing.theater | displayName }}
                                    </a> 
                                    <a href="{{ listing.map }}" target="_blank" class="area-link" >
                                        {{ listing.area | replace("_", " ") | title }}
                                    </a>
                                    <span class="showtimes">
                                        {% for showing in listing.showings %}
                                            <a href="{{ showing.link }}" 
                                            target="_blank" 
                                            class="time {% if showing.available == 'SOLD OUT' %}sold-out{% endif %}"
                                            data-date="{{ m.date }}"
                                            data-time="{{ showing.time }}">
                                                {{ showing.time | formatTime }}
                                            </a>
                                            {% if not loop.last %}<span class="time-sep"> | </span>{% endif %}
                                        {% endfor %}  {# showing #}
                                    </span>
                                </div>
                            {% endfor %}  {# theater #}
                        </div>
                    </div>
                    {% if not loop.last %}
                        <div class="divider"></div>
                    {% else %}
                    {% for _ in range(4) %}<br>{% endfor %}  {# spacing #}
                    {% endif %}
                {% endfor %}  {# movie #}
            {% endfor %}  {# date #}
        {% else %}
            <p>No movie data available</p>
        {% endif %}
        </main>

        <footer class="site-footer">
            <p>
                Spiral HWY collects daily movie showtimes from independent and
                repertory cinemas across San Francisco, so you can see what's
                playing tonight in one place.
            </p>
            {% if theaters | length %}
                <h2 class="footer-heading">Theaters</h2>
                <ul class="footer-theaters">
                    {% for t in theaters %}
                        <li>
                            <a href="{{ t.theater_link }}" target="_blank" rel="noopener">{{ t.theater | displayName }}</a>
                            <span class="footer-area">({{ t.area | replace("_", " ") | title }})</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </footer>
        <script>
        // Remove showings that have already started (in San Francisco time),
        // along with any listings, movies, and dates left empty as a result.
        // Runs first so the observers and filters below only see what remains.
        (function() {
            const parts = {};
            new Intl.DateTimeFormat('en-US', {
                timeZone: 'America/Los_Angeles',
                year: 'numeric', month: '2-digit', day: '2-digit',
                hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
            }).formatToParts(new Date()).forEach(function(p) { parts[p.type] = p.value; });
            const nowDate = parts.year + '-' + parts.month + '-' + parts.day;
            const nowTime = parts.hour + parts.minute;

            document.querySelectorAll('.showtimes .time').forEach(function(el) {
                const date = el.dataset.date;
                if (date < nowDate || (date === nowDate && el.dataset.time < nowTime)) {
                    el.remove();
                }
            });

            // Tidy separators so remaining times read "a | b" with no stray pipes.
            document.querySelectorAll('.showtimes').forEach(function(showtimes) {
                let prevIsTime = false;
                Array.from(showtimes.children).forEach(function(child) {
                    if (child.classList.contains('time-sep')) {
                        if (!prevIsTime) child.remove();
                        prevIsTime = false;
                    } else {
                        prevIsTime = true;
                    }
                });
                const last = showtimes.lastElementChild;
                if (last && last.classList.contains('time-sep')) last.remove();
            });

            document.querySelectorAll('.theater-info').forEach(function(el) {
                if (!el.querySelector('.showtimes .time')) el.remove();
            });

            document.querySelectorAll('.movie-block').forEach(function(block) {
                if (block.querySelector('.theater-info')) return;
                const prev = block.previousElementSibling;
                const next = block.nextElementSibling;
                if (prev && prev.classList.contains('divider')) prev.remove();
                else if (next && next.classList.contains('divider')) next.remove();
                block.remove();
            });

            document.querySelectorAll('.sticky-wrapper').forEach(function(wrapper) {
                const toRemove = [wrapper];
                let sibling = wrapper.nextElementSibling;
                while (sibling && !sibling.classList.contains('sticky-wrapper') && sibling.tagName !== 'SCRIPT') {
                    if (sibling.classList.contains('movie-block')) return;
                    toRemove.push(sibling);
                    sibling = sibling.nextElementSibling;
                }
                toRemove.forEach(function(el) { el.remove(); });
            });

            // The build sorts by each movie's first showing of the day, but today's
            // earliest showings may have just been removed. Re-sort today's listings
            // and movies by their earliest remaining showing.
            const today = document.getElementById('date-' + nowDate);
            if (!today) return;

            function earliestTime(el) {
                let earliest = Infinity;
                el.querySelectorAll('.showtimes .time').forEach(function(t) {
                    earliest = Math.min(earliest, parseInt(t.dataset.time, 10));
                });
                return earliest;
            }

            const blocks = [];
            let sibling = today.nextElementSibling;
            while (sibling && !sibling.classList.contains('sticky-wrapper') && sibling.tagName !== 'SCRIPT') {
                const next = sibling.nextElementSibling;
                if (sibling.classList.contains('movie-block')) blocks.push(sibling);
                if (sibling.classList.contains('movie-block') || sibling.classList.contains('divider')) {
                    sibling.remove();
                }
                sibling = next;
            }

            blocks.forEach(function(block) {
                const info = block.querySelector('.movie-info');
                Array.from(info.querySelectorAll('.theater-info'))
                    .sort(function(a, b) { return earliestTime(a) - earliestTime(b); })
                    .forEach(function(listing) { info.appendChild(listing); });
            });

            // Array.prototype.sort is stable, so ties keep the build's order.
            blocks.sort(function(a, b) { return earliestTime(a) - earliestTime(b); });

            let anchor = today;
            blocks.forEach(function(block, i) {
                if (i > 0) {
                    const divider = document.createElement('div');
                    divider.className = 'divider';
                    anchor.after(divider);
                    anchor = divider;
                }
                anchor.after(block);
                anchor = block;
            });
        })();

        {% include "sticky_dates.js" %}
        (function() {
            const corporate = ['alamo_drafthouse_sf', 'landmark_opera_plaza'];

            // Discover all theaters from the rendered listings.
            const theaters = new Map();
            document.querySelectorAll('.theater-info').forEach(function(el) {
                const slug = el.dataset.theater;
                if (!theaters.has(slug)) {
                    const nameEl = el.querySelector('.theater-name');
                    theaters.set(slug, nameEl ? nameEl.textContent.trim() : slug);
                }
            });
            const allSlugs = Array.from(theaters.keys()).sort(function(a, b) {
                return theaters.get(a).localeCompare(theaters.get(b));
            });
            const indieSlugs = allSlugs.filter(function(s) { return !corporate.includes(s); });
            const selected = new Set();

            const indieBtn = document.getElementById('indie-mode-btn');
            const filterBtn = document.getElementById('theater-filter-btn');
            const filterPanel = document.getElementById('theater-filter-panel');
            const filterList = document.getElementById('theater-filter-list');
            const resetLink = document.getElementById('theater-filter-reset');

            allSlugs.forEach(function(slug) {
                const label = document.createElement('label');
                label.className = 'theater-filter-option';
                const cb = document.createElement('input');
                cb.type = 'checkbox';
                cb.checked = false;
                cb.dataset.theater = slug;
                cb.addEventListener('change', function() {
                    if (cb.checked) selected.add(slug);
                    else selected.delete(slug);
                    applyFilter();
                });
                label.appendChild(cb);
                label.appendChild(document.createTextNode(' ' + theaters.get(slug)));
                filterList.appendChild(label);
            });

            function isIndieSelection() {
                if (selected.size !== indieSlugs.length) return false;
                for (const s of indieSlugs) {
                    if (!selected.has(s)) return false;
                }
                return true;
            }

            function applyFilter() {
                // Empty selection means show all; otherwise show only the selected.
                const showAll = selected.size === 0;
                document.querySelectorAll('.theater-info').forEach(function(el) {
                    el.style.display = (showAll || selected.has(el.dataset.theater)) ? '' : 'none';
                });
                document.querySelectorAll('.movie-block').forEach(function(block) {
                    const listings = block.querySelectorAll('.theater-info');
                    const visible = Array.from(listings).some(function(el) {
                        return el.style.display !== 'none';
                    });
                    block.style.display = visible ? '' : 'none';
                    const next = block.nextElementSibling;
                    if (next && next.classList.contains('divider')) {
                        next.style.display = visible ? '' : 'none';
                    }
                });
                document.querySelectorAll('.sticky-wrapper').forEach(function(wrapper) {
                    let sibling = wrapper.nextElementSibling;
                    let anyVisible = false;
                    while (sibling && !sibling.classList.contains('sticky-wrapper')) {
                        if (sibling.classList.contains('movie-block') && sibling.style.display !== 'none') {
                            anyVisible = true;
                            break;
                        }
                        sibling = sibling.nextElementSibling;
                    }
                    wrapper.style.display = anyVisible ? '' : 'none';
                });
                indieBtn.textContent = isIndieSelection() ? 'Reset Filter' : 'Indie Mode';
            }

            function setSelected(slugs) {
                selected.clear();
                slugs.forEach(function(s) { selected.add(s); });
                filterList.querySelectorAll('input[type="checkbox"]').forEach(function(cb) {
                    cb.checked = selected.has(cb.dataset.theater);
                });
                applyFilter();
            }

            indieBtn.addEventListener('click', function() {
                if (isIndieSelection()) {
                    setSelected([]);
                } else {
                    setSelected(indieSlugs);
                }
            });

            resetLink.addEventListener('click', function(e) {
                e.preventDefault();
                setSelected([]);
            });

            filterBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                filterPanel.classList.toggle('open');
                filterBtn.classList.toggle('open');
            });

            document.addEventListener('click', function(e) {
                if (!filterPanel.contains(e.target) && e.target !== filterBtn) {
                    filterPanel.classList.remove('open');
                    filterBtn.classList.remove('open');
                }
            });

            applyFilter();
        })();

        {% set calendarDates = movies | pluck("date") %}
        {% include "calendar.js" %}
        </script>
    </body>
</html>
