{#- The site root forwards to the cinema listings. GitHub Pages can't send
    server-side redirects, so this is a meta refresh (with a link fallback). -#}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Spiral HWY</title>
        <meta name="description" content="Spiral HWY: San Francisco cinema showtimes and live music listings.">
        <meta name="keywords" content="Spiral HWY, San Francisco cinema, San Francisco music">
        <link rel="canonical" href="{{ site.url }}/cinema/">
        <meta name="robots" content="noindex">
        <meta http-equiv="refresh" content="0; url=cinema/">
        <script>window.location.replace("cinema/" + window.location.hash);</script>
    </head>
    <body>
        <p>
            <a href="cinema/">Cinema</a> | <a href="music/">Music</a>
        </p>
    </body>
</html>
